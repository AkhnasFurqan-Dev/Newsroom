{% extends "base.html.j2" %}
{% block title %}Diagnostics{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <h1>Diagnostics</h1>
    
  </div>
</div>

<div class="grid grid--4">
  <div class="card"><div class="card__label">Posts</div><div class="card__value">{{ counts.posts }}</div></div>
  <div class="card"><div class="card__label">Stories</div><div class="card__value">{{ counts.stories }}</div></div>
  <div class="card"><div class="card__label">Articles</div><div class="card__value">{{ counts.articles }}</div></div>
  <div class="card"><div class="card__label">Editions</div><div class="card__value">{{ counts.editions }}</div></div>
</div>

<h2>Checks</h2>
<div class="table-wrap">
  <table>
    <thead><tr><th>Component</th><th>Status</th><th>Result</th><th>Next action</th></tr></thead>
    <tbody>
    {% for label, result, ok, action in checks %}
      <tr>
        <td><strong>{{ label }}</strong></td>
        <td>{% if ok %}<span class="badge badge--published">Ready</span>{% else %}<span class="badge badge--review">Attention</span>{% endif %}</td>
        <td>{{ result }}</td>
        <td class="small">{{ action or '—' }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>

<h2>Configuration</h2>
<div class="table-wrap">
  <table>
    <thead><tr><th>Item</th><th>Value</th></tr></thead>
    <tbody>
      <tr><td>Environment file</td><td class="mono">{{ env_file }}</td></tr>
      <tr><td>Telegram session file</td><td class="mono">{{ session_file }}</td></tr>
      <tr><td>Telegram API id/hash</td><td>{{ 'configured' if telegram.credentials_configured else 'missing (fixture/import mode)' }}</td></tr>
      <tr><td>Telegram session</td><td>{{ 'present' if telegram.session_present else 'not created' }}</td></tr>
      <tr><td>Ollama endpoint</td><td class="mono">{{ ollama.base_url }}</td></tr>
      <tr><td>Local model</td><td>{{ ollama.model }} · {% if ollama.model_ready %}tested and ready{% elif ollama.model_present %}installed; draft test required{% elif ollama.reachable %}runtime running, model missing{% else %}not reachable{% endif %}</td></tr>
      <tr><td>AI model controls</td><td><a href="/ai-models">Open AI Models</a></td></tr>
      <tr><td>Pending jobs</td><td>{{ pending_jobs }}</td></tr>
    </tbody>
  </table>
</div>

<h2>Data and privacy</h2>
<div class="notice">
  <p>The database, media derivatives and published bundles stay under the local <span class="mono">data/</span> and <span class="mono">output/</span> folders. Credentials are optional, stored outside Git, and never rendered into print output or manifests.</p>
  <p>The Telegram session file behaves like a password. Anyone with a copy can act as that account until it is revoked. Sign out from the source connection page to delete it.</p>
  <p>Use <span class="mono">channel-press backup</span> before upgrades. Restore requires the server and worker to be stopped.</p>
</div>
{% endblock %}
