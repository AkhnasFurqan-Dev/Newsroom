{% extends "base.html.j2" %}
{% block title %}Branding{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <div class="kicker">Publication identity</div>
    <h1>Branding &amp; edition policy</h1>
    <p class="lede">These values drive the masthead, section order, cartographic convention and source-link policy. Changes apply to the next build; existing editions keep their profile snapshot.</p>
  </div>
</div>

{% set order = profile.section_order_json|json_loads([]) %}
<form method="post" action="/branding" class="stack" style="max-width:960px">
  <input type="hidden" name="csrf_token" value="{{ csrf }}">
  <div class="grid grid--2">
    <div class="field"><label for="name">Publication name</label><input id="name" name="name" type="text" value="{{ profile.name }}" required></div>
    <div class="field"><label for="channel_handle">Source channel handle</label><input id="channel_handle" name="channel_handle" type="text" value="{{ profile.channel_handle }}"></div>
    <div class="field"><label for="byline">Byline (printed under every headline)</label><input id="byline" name="byline" type="text" value="{{ profile.byline }}" placeholder="Editorial Desk"></div>
    <div class="field"><label for="source_disclosure">Source disclosure (evidence statement)</label><textarea id="source_disclosure" name="source_disclosure" style="min-height:70px" placeholder="Editorial roundup based primarily on authorized posts published by …">{{ profile.source_disclosure }}</textarea></div>
    <div class="field"><label for="slogan">Slogan</label><input id="slogan" name="slogan" type="text" value="{{ profile.slogan }}"></div>
    <div class="field"><label for="city">City</label><input id="city" name="city" type="text" value="{{ profile.city }}"></div>
    <div class="field"><label for="timezone">Timezone (IANA)</label><input id="timezone" name="timezone" type="text" value="{{ profile.timezone }}" required></div>
    <div class="field"><label for="accent">Accent colour</label><input id="accent" name="accent" type="text" value="{{ profile.accent }}" pattern="#[0-9a-fA-F]{6}" required></div>
    <div class="field"><label for="paper_size">Paper size</label>
      <select id="paper_size" name="paper_size">
        <option value="tabloid" {% if profile.paper_size == 'tabloid' %}selected{% endif %}>Tabloid 11 × 17 in</option>
        <option value="a3" {% if profile.paper_size == 'a3' %}selected{% endif %}>A3 297 × 420 mm</option>
      </select>
    </div>
    <div class="field"><label for="issue_volume">Volume number</label><input id="issue_volume" name="issue_volume" type="number" min="1" value="{{ profile.issue_volume }}"></div>
    <div class="field"><label for="map_profile">Cartographic convention</label>
      <select id="map_profile" name="map_profile">
        {% for item in maps %}<option value="{{ item.key }}" {% if profile.map_profile == item.key %}selected{% endif %}>{{ item.name }}</option>{% endfor %}
      </select>
    </div>
    <div class="field"><label for="qr_strategy">Source link / QR policy</label>
      <select id="qr_strategy" name="qr_strategy">
        <option value="appendix" {% if profile.qr_strategy == 'appendix' %}selected{% endif %}>Appendix links; QR only when verified reachable</option>
        <option value="verified_only" {% if profile.qr_strategy == 'verified_only' %}selected{% endif %}>Verified public QR only</option>
        <option value="none" {% if profile.qr_strategy == 'none' %}selected{% endif %}>No QR codes</option>
      </select>
    </div>
    <div class="field"><label for="contact_url">Contact / public URL</label><input id="contact_url" name="contact_url" type="text" value="{{ profile.contact_url }}"></div>
  </div>

  <div class="field"><label for="footer_text">Footer / provenance text</label><textarea id="footer_text" name="footer_text" style="min-height:90px">{{ profile.footer_text }}</textarea></div>

  <h2>Section order</h2>
  <p class="help">Sections without articles are omitted. The front page is always first and the source appendix is always last.</p>
  <div class="field-row">
    {% for key, label in sections %}{% if key != 'front' %}
    <label class="field--inline"><input type="checkbox" name="section_order" value="{{ key }}" {% if key in order or not order %}checked{% endif %}> {{ label }}</label>
    {% endif %}{% endfor %}
  </div>

  <label class="field--inline"><input type="checkbox" name="allow_closing_light" value="1" {% if profile.allow_closing_light %}checked{% endif %}> Allow closing light only when a documented true source is available</label>

  <div><button type="submit">Save publication profile</button></div>
</form>

<h2>Newspapers on this computer</h2>
<p class="help">Each newspaper keeps its own branding, source list, schedules, drafts, editions and archive. Switching changes the dashboard you are working in; it does not publish anything.</p>
<div class="table-wrap">
  <table>
    <thead><tr><th>Newspaper</th><th>Slug</th><th>Timezone</th><th>Status</th><th>Open</th></tr></thead>
    <tbody>
    {% for paper in publications %}
      <tr>
        <td><strong>{{ paper.name }}</strong>{% if profile and paper.id == profile.id %} <span class="badge badge--approved">current</span>{% endif %}</td>
        <td class="mono">{{ paper.slug }}</td>
        <td>{{ paper.timezone }}</td>
        <td>{% if paper.is_active %}<span class="badge badge--approved">active</span>{% else %}<span class="badge">inactive</span>{% endif %}</td>
        <td>
          {% if not profile or paper.id != profile.id %}
          <form method="post" action="/publications/select" class="inline">
            <input type="hidden" name="csrf_token" value="{{ csrf }}">
            <input type="hidden" name="publication_id" value="{{ paper.id }}">
            <button class="btn btn--small" type="submit">Switch</button>
          </form>
          {% endif %}
          {% if can.own and profile and paper.id == profile.id %}
          <form method="post" action="/publications/{{ paper.id }}/activate" class="inline">
            <input type="hidden" name="csrf_token" value="{{ csrf }}">
            <input type="hidden" name="active" value="{{ '0' if paper.is_active else '1' }}">
            <button class="btn btn--small btn--ghost" type="submit">{{ 'Deactivate' if paper.is_active else 'Reactivate' }}</button>
          </form>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>

{% if can.own %}
<form method="post" action="/publications/new" class="grid grid--4" style="margin:14px 0 26px; align-items:end">
  <input type="hidden" name="csrf_token" value="{{ csrf }}">
  <div class="field"><label for="new_publication_name">New newspaper</label><input id="new_publication_name" name="name" type="text" placeholder="Evening Ledger" required></div>
  <div class="field"><label for="new_publication_city">City</label><input id="new_publication_city" name="city" type="text" value="{{ profile.city if profile else 'Karachi' }}"></div>
  <div class="field"><label for="new_publication_tz">Timezone</label><input id="new_publication_tz" name="timezone" type="text" value="{{ profile.timezone if profile else 'Asia/Karachi' }}"></div>
  <div><button type="submit" class="btn btn--ghost">Create newspaper</button></div>
</form>
{% endif %}

{% if profile %}
<h2>Sources for {{ profile.name }}</h2>
<p class="help">A source is an authorized channel that may contribute posts to this newspaper. Priority 1 is used first; weight scales story prominence. Disabling a source keeps its archive and Telegram access but excludes it from the next build.</p>
<div class="table-wrap">
  <table>
    <thead><tr><th>Channel</th><th>Priority</th><th>Weight</th><th>State</th><th>Update</th></tr></thead>
    <tbody>
    {% for row in source_links %}
      <tr>
        <td><strong>{{ row.channel.title }}</strong><div class="small">{{ row.channel.handle }}{% if row.channel.is_demo %} · demonstration channel{% endif %}</div></td>
        <td colspan="3">
          <form method="post" action="/publications/{{ profile.id }}/sources" class="field-row">
            <input type="hidden" name="csrf_token" value="{{ csrf }}">
            <input type="hidden" name="channel_id" value="{{ row.channel.id }}">
            <input name="priority" type="number" min="1" value="{{ row.link.priority }}" style="max-width:80px">
            <input name="weight" type="number" step="0.1" min="0.1" max="5" value="{{ row.link.weight }}" style="max-width:80px">
            <label class="field--inline"><input type="checkbox" name="enabled" value="1" {% if row.link.is_enabled %}checked{% endif %}> enabled</label>
            <button class="btn btn--small" type="submit">Save</button>
          </form>
        </td>
        <td>
          <form method="post" action="/publications/{{ profile.id }}/sources/{{ row.link.id }}/remove" class="inline">
            <input type="hidden" name="csrf_token" value="{{ csrf }}">
            <button class="btn btn--small btn--danger" type="submit">Remove</button>
          </form>
        </td>
      </tr>
    {% else %}
      <tr><td colspan="5" class="small">No source channels linked yet. Add an authorized channel below.</td></tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% if available_channels %}
<form method="post" action="/publications/{{ profile.id }}/sources" class="grid grid--4" style="margin:12px 0 26px; align-items:end">
  <input type="hidden" name="csrf_token" value="{{ csrf }}">
  <div class="field"><label for="add_source_channel">Add authorized channel</label>
    <select id="add_source_channel" name="channel_id">
      {% for channel in available_channels %}<option value="{{ channel.id }}">{{ channel.title }} ({{ channel.handle }})</option>{% endfor %}
    </select>
  </div>
  <div class="field"><label for="add_source_priority">Priority</label><input id="add_source_priority" name="priority" type="number" min="1" value="100"></div>
  <div class="field"><label for="add_source_weight">Weight</label><input id="add_source_weight" name="weight" type="number" step="0.1" min="0.1" max="5" value="1"></div>
  <div><input type="hidden" name="enabled" value="1"><button type="submit" class="btn btn--ghost">Link source</button></div>
</form>
{% endif %}

<h2>Editors for {{ profile.name }}</h2>
<p class="help">Publication editors can work on this newspaper without gaining access to another paper. Telegram rights and channel ownership remain separate grants.</p>
<div class="table-wrap">
  <table>
    <thead><tr><th>Person</th><th>Newspaper role</th><th>Global role</th><th></th></tr></thead>
    <tbody>
    {% for row in publication_editors %}
      <tr>
        <td><strong>{{ row.user.display_name }}</strong><div class="small">{{ row.user.username }}</div></td>
        <td>{{ row.membership.role|status_label }}</td>
        <td>{{ row.user.role|status_label }}</td>
        <td>
          {% if can.own and row.user.role != 'owner' %}
          <form method="post" action="/publications/{{ profile.id }}/editors/{{ row.membership.id }}/remove" class="inline">
            <input type="hidden" name="csrf_token" value="{{ csrf }}">
            <button class="btn btn--small btn--danger" type="submit">Remove</button>
          </form>
          {% endif %}
        </td>
      </tr>
    {% else %}
      <tr><td colspan="4" class="small">Only owners can open this newspaper. Add an editor to delegate it.</td></tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% if can.own and available_users %}
<form method="post" action="/publications/{{ profile.id }}/editors" class="grid grid--3" style="margin:12px 0 26px; align-items:end">
  <input type="hidden" name="csrf_token" value="{{ csrf }}">
  <div class="field"><label for="add_editor_user">Add editor</label>
    <select id="add_editor_user" name="username">
      {% for member in available_users %}<option value="{{ member.username }}">{{ member.display_name }} ({{ member.username }})</option>{% endfor %}
    </select>
  </div>
  <div class="field"><label for="add_editor_role">Newspaper role</label>
    <select id="add_editor_role" name="role">
      <option value="editor">Editor</option>
      <option value="operator">Operator</option>
      <option value="viewer">Viewer</option>
    </select>
  </div>
  <div><button type="submit" class="btn btn--ghost">Grant access</button></div>
</form>
{% endif %}
{% endif %}

<h2>Current map conventions</h2>
<div class="table-wrap">
  <table>
    <thead><tr><th>Profile</th><th>Dataset</th><th>License</th><th>Disputed-boundary rule</th></tr></thead>
    <tbody>
    {% for item in maps %}
      <tr>
        <td><strong>{{ item.name }}</strong><div class="small">{{ item.key }}{% if not item.enabled %} · disabled{% endif %}</div></td>
        <td>{{ item.dataset }}<div class="small">{{ item.dataset_version }}</div></td>
        <td>{{ item.license }}</td>
        <td class="small">{{ item.disputed_rule }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
