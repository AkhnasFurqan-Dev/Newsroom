<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ app_name }}{% endblock %} · {{ profile.name if profile else app_name }}</title>
  <link rel="stylesheet" href="/static/css/app.css">
  {% block head %}{% endblock %}
</head>
<body>
{% set tz = profile.timezone if profile else 'Asia/Karachi' %}
<header class="topbar">
  <a class="brand" href="/">{{ profile.name if profile else app_name }}<span>.</span></a>
  {% if user and publications %}
  <form class="pub-select" method="post" action="/publications/select">
    <input type="hidden" name="csrf_token" value="{{ csrf }}">
    <label for="publication-select">Newspaper</label>
    <select id="publication-select" name="publication_id">
      {% for paper in publications %}
      <option value="{{ paper.id }}" {% if profile and paper.id == profile.id %}selected{% endif %}>{{ paper.name }}{% if not paper.is_active %} (inactive){% endif %}</option>
      {% endfor %}
    </select>
    <button type="submit" class="btn btn--small btn--ghost">Switch</button>
  </form>
  {% endif %}
  <div class="topbar__meta">
    <div>{{ app_name }} newsroom</div>
    <div>{{ today|localtime(tz, '%A, %d %B %Y') }} · {{ tz }}</div>
    {% if user %}<div>{{ user.display_name }} · {{ user.role }}</div>{% endif %}
  </div>
</header>

{% if user %}
<nav class="mainnav" aria-label="Main navigation">
  <a href="/" class="{{ 'is-active' if active == 'dashboard' }}">Dashboard</a>
  <a href="/sources" class="{{ 'is-active' if active == 'sources' }}">Sources</a>
  <a href="/stories" class="{{ 'is-active' if active == 'stories' }}">Stories</a>
  <a href="/articles" class="{{ 'is-active' if active == 'articles' }}">Articles</a>
  <a href="/build" class="{{ 'is-active' if active == 'build' }}">Build</a>
  <a href="/editions" class="{{ 'is-active' if active == 'editions' }}">Editions</a>
  <a href="/schedules" class="{{ 'is-active' if active == 'schedules' }}">Schedules</a>
  <a href="/jobs" class="{{ 'is-active' if active == 'jobs' }}">Jobs</a>
  {% if can.edit %}<a href="/ai-models" class="{{ 'is-active' if active == 'ai_models' }}">AI Models</a>{% endif %}
  {% if can.own %}<a href="/connections" class="{{ 'is-active' if active == 'connections' }}">Connections</a>{% endif %}
  {% if can.edit %}<a href="/media-cache" class="{{ 'is-active' if active == 'media_cache' }}">Media cache</a>{% endif %}
  <a href="/branding" class="{{ 'is-active' if active == 'branding' }}">Branding</a>
  {% if can.edit %}<a href="/appearance" class="{{ 'is-active' if active == 'appearance' }}">Appearance</a>{% endif %}
  {% if can.own %}<a href="/users" class="{{ 'is-active' if active == 'users' }}">Users</a>{% endif %}
  {% if can.edit %}<a href="/audit" class="{{ 'is-active' if active == 'audit' }}">Audit</a>{% endif %}
  {% if can.own %}<a href="/diagnostics" class="{{ 'is-active' if active == 'diagnostics' }}">Diagnostics</a>{% endif %}
</nav>
{% endif %}

<main class="shell {% block shell_class %}{% endblock %}">
  {% if message %}<div class="flash" role="status">{{ message }}</div>{% endif %}
  {% if error %}<div class="flash flash--error" role="alert">{{ error }}</div>{% endif %}
  {% block content %}{% endblock %}
</main>

<footer class="site-footer">
  <span>{{ profile.name if profile else app_name }}</span>
  <span>{% if user %}<a href="/account">Account</a> · {% endif %}Data stays on this computer.</span>
</footer>
{% if desktop_mode %}
<div id="desktop-close-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="desktop-close-title"
     style="position:fixed;inset:0;background:#171615a8;z-index:1000;display:grid;place-items:center;padding:24px">
  <style>#desktop-close-dialog[hidden]{display:none!important}</style>
  <section class="card" style="width:min(560px,100%);background:#fff">
    <h2 id="desktop-close-title">Close Channel Press?</h2>
    <p>Choose what should happen to work that is still running.</p>
    <p id="desktop-close-status" role="status" class="small"></p>
    <div class="actions">
      <button class="btn" type="button" data-desktop-close="continue">Continue in background</button>
      <button class="btn btn--ghost" type="button" data-desktop-close="pause">Pause safely and exit</button>
      <button class="btn btn--ghost" type="button" id="desktop-close-cancel">Keep open</button>
    </div>
  </section>
</div>
<script>
(() => {
  const dialog = document.getElementById("desktop-close-dialog");
  const status = document.getElementById("desktop-close-status");
  window.addEventListener("channel-press-close-request", () => {
    dialog.hidden = false;
    dialog.querySelector("[data-desktop-close='continue']").focus();
  });
  document.getElementById("desktop-close-cancel").addEventListener("click", () => {
    dialog.hidden = true;
  });
  dialog.querySelectorAll("[data-desktop-close]").forEach((button) => {
    button.addEventListener("click", async () => {
      button.disabled = true;
      status.textContent = "Applying your choice…";
      try {
        const result = await window.pywebview.api.shutdown(button.dataset.desktopClose);
        status.textContent = result.message;
        if (!result.closed) button.disabled = false;
      } catch (_) {
        status.textContent = "The close action failed. Keep this window open and retry.";
        button.disabled = false;
      }
    });
  });
})();
</script>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
