{% extends "base.html.j2" %}
{% block title %}{{ story.canonical_title }}{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <div class="kicker">{{ section_labels.get(story.section, story.section) }} · {{ story.genre|status_label }}</div>
    <h1>{{ story.canonical_title }}</h1>
    <p class="lede">{{ story.summary }}</p>
  </div>
  <div class="page-head__actions">
    <span class="badge badge--{{ story.risk_level }}">Risk: {{ story.risk_level }}</span>
    {% if article %}<a class="btn" href="/articles/{{ article.id }}">Open article</a>{% endif %}
  </div>
</div>

<div class="grid grid--sidebar">
  <div>
    <h2>Claim ledger</h2>
    <p class="help">Every hard fact in a draft must trace to these claims. A correction supersedes an earlier claim without deleting it.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Claim</th><th>Type</th><th>Certainty</th><th>Verification</th><th>Event time</th><th>Source</th></tr></thead>
        <tbody>
        {% for claim in claims %}
          <tr>
            <td>{{ claim.text[:280] }}{% if claim.text|length > 280 %}…{% endif %}</td>
            <td>{{ claim.claim_type }}</td>
            <td>{{ claim.certainty }}</td>
            <td>{{ claim.verification_status }}</td>
            <td class="small">{{ claim.event_at|localtime(profile.timezone if profile else 'Asia/Karachi') if claim.event_at else '—' }}</td>
            <td class="small">{% if claim.source_post_id %}post #{{ claim.source_post_id }}{% else %}—{% endif %}</td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="muted">No claims built yet. Claims are extracted during the edition build.</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

    <h2>Source fragments</h2>
    {% for fragment, post in fragments %}
      <div class="card" style="margin-bottom:10px">
        <div class="split">
          <strong>Message {{ post.telegram_message_id }}</strong>
          <span class="small">{{ post.posted_at|localtime(profile.timezone if profile else 'Asia/Karachi') }}</span>
        </div>
        <p class="prose prose--ui" style="margin:8px 0 0">{{ fragment.text }}</p>
        {% if post.source_url %}<div class="small"><a href="{{ post.source_url }}" rel="noreferrer">{{ post.source_url }}</a></div>{% endif %}
      </div>
    {% else %}
      <p class="muted">No fragments attached.</p>
    {% endfor %}

    <h2 id="research">Research context</h2>
    <div class="small muted">
      Search:
      {% if research_provider.status == 'ready' %}
        {{ research_provider.label }} · Ready
      {% else %}
        Unavailable · {{ research_provider.detail }}
      {% endif %}
      · Policy: {{ research_policy|replace('_', ' ') }}
    </div>
    {% if can.edit %}
    <div class="field-row" style="margin:10px 0">
      <form method="post" action="/stories/{{ story.id }}/research/discover">
        <input type="hidden" name="csrf_token" value="{{ csrf }}">
        <button type="submit"{% if research_provider.status != 'ready' %} disabled title="{{ research_provider.detail }}"{% endif %}>Search sources</button>
      </form>
      <form method="post" action="/stories/{{ story.id }}/research" class="field-row">
        <input type="hidden" name="csrf_token" value="{{ csrf }}">
        <input name="url" type="url" placeholder="https://example.org/report" required style="min-width:280px" aria-label="Public source URL">
        <button type="submit">Add URL</button>
      </form>
    </div>
    {% endif %}
    <p class="help">Candidates stay out of the paper until an editor accepts them. Accepted pages are attributed context, not automatic verification.</p>
    {% for ref in external %}
      <div class="card" style="margin-bottom:8px">
        <div class="split">
          <strong>{{ ref.title or ref.url }}</strong>
          <span class="badge badge--{{ 'approved' if ref.review_status == 'accepted' else ('rejected' if ref.review_status == 'rejected' else 'review') }}">{{ ref.review_status|status_label }}</span>
        </div>
        <div class="small"><a href="{{ ref.url }}" rel="noopener nofollow noreferrer">{{ ref.url }}</a></div>
        <div class="small">{{ ref.publisher }}{% if ref.published_at %} · published {{ ref.published_at|shortdate }}{% endif %}{% if ref.http_status %} · HTTP {{ ref.http_status }}{% endif %} · accessed {{ ref.accessed_at|shortdate }}</div>
        {% if ref.search_query %}<div class="small muted">Query: {{ ref.search_query }}{% if ref.relevance %} · match {{ '%.2f'|format(ref.relevance) }}{% endif %}</div>{% endif %}
        {% if ref.excerpt %}<p class="small">{{ ref.excerpt[:280] }}{% if ref.excerpt|length > 280 %}…{% endif %}</p>{% endif %}
        {% if ref.terms_note %}<div class="small muted">{{ ref.terms_note }}</div>{% endif %}
        {% if can.edit and ref.review_status != 'accepted' %}
        <form method="post" action="/stories/{{ story.id }}/research/{{ ref.id }}/review" class="field-row" style="margin-top:6px">
          <input type="hidden" name="csrf_token" value="{{ csrf }}">
          <button type="submit" name="decision" value="accept" class="btn--small">Accept context</button>
          <button type="submit" name="decision" value="reject" class="btn--danger btn--small">Reject</button>
        </form>
        {% endif %}
      </div>
    {% else %}
      <p class="muted">No external references recorded for this story.</p>
    {% endfor %}
  </div>

  <aside>
    <h2>Chronology</h2>
    {% for event in timeline %}
      <div class="card" style="margin-bottom:8px">
        <div class="small">{{ event.event_at|localtime(profile.timezone if profile else 'Asia/Karachi') }} · {{ event.certainty }}</div>
        <div>{{ event.description }}</div>
      </div>
    {% else %}
      <p class="muted">No timeline events.</p>
    {% endfor %}

    <h2>Story state</h2>
    <div class="card">
      <div class="small">Fingerprint</div>
      <div class="mono">{{ story.fingerprint }}</div>
      <div class="small" style="margin-top:8px">Created {{ story.created_at|localtime(profile.timezone if profile else 'Asia/Karachi') }}</div>
      <div class="small">Updated {{ story.updated_at|localtime(profile.timezone if profile else 'Asia/Karachi') }}</div>
      <div class="small">Channel #{{ story.channel_id }}</div>
    </div>
  </aside>
</div>
{% endblock %}
