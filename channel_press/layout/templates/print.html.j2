<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=1056, initial-scale=1">
<title>{{ profile.name }} — {{ edition_date }}</title>
<style>
{{ print_css|safe }}
</style>
</head>
<body class="{% if demo_edition %}is-demo{% endif %}">
{% macro story_qr(chunk) -%}
{% if chunk.package.qr_data_uri %}
<div class="story__qr">
  <img src="{{ chunk.package.qr_data_uri }}" alt="QR code linking to the sources for this report" width="72" height="72">
  <span>{{ chunk.package.qr_label }}</span>
</div>
{% endif %}
{%- endmacro %}
{% macro story_article(chunk, section, tmpl) -%}
<article class="story story--{{ tmpl }}" data-story-id="{{ chunk.package.story.id }}" data-article-id="{{ chunk.package.article.id }}" data-chunk="{{ chunk.index }}" data-chunk-count="{{ chunk.count }}" data-template="{{ tmpl }}">
  {% if chunk.index == 1 %}
  <div class="kicker">{{ section_label(section) }}{% if chunk.package.genre != 'news' and chunk.package.genre != section %} · {{ genre_label(chunk.package.genre) }}{% endif %}</div>
  <h2 class="story__headline">{{ chunk.package.headline }}</h2>
  {% if profile.byline %}<div class="story__byline">By {{ profile.byline }}</div>{% endif %}
  {{ story_qr(chunk) }}
  {% if chunk.package.deck %}<p class="story__deck">{{ chunk.package.deck }}</p>{% endif %}
  {% if chunk.package.standfirst %}<p class="story__standfirst">{{ chunk.package.standfirst }}</p>{% endif %}
  {% if tmpl == 'analysis_feature' %}<div class="genre-label">Analysis · interpretation of verified reporting</div>{% endif %}
  {% if tmpl == 'opinion' %}<div class="genre-label">Opinion · the publication's view</div>{% endif %}
  {% if media_html(chunk.package) %}{{ media_html(chunk.package) }}{% endif %}
  {% else %}
  <div class="continuation-head">{{ chunk.package.headline }}</div>
  {% endif %}
  <div class="story__body">{{ paragraphs_html(chunk.paragraphs) }}</div>
  {% if chunk.index == chunk.count %}
    {% if chunk.package.chart_svg and not chunk.package.media_path %}<figure class="story__graphic">{{ chunk.package.chart_svg|safe }}<figcaption>{{ chunk.package.chart_spec.title }}</figcaption></figure>{% endif %}
    {% if chunk.package.timeline_html %}{{ chunk.package.timeline_html|safe }}{% endif %}
    {% if chunk.package.correction_note %}<p class="correction-note">{{ chunk.package.correction_note }}</p>{% endif %}
  {% endif %}
  {% if chunk.index < chunk.count %}<div class="continues" data-story-id="{{ chunk.package.story.id }}" data-next-chunk="{{ chunk.index + 1 }}">Continued on page <span class="page-ref">?</span></div>{% endif %}
</article>
{%- endmacro %}
<main id="source">

  <section class="page-front" data-template="{{ front_template }}" data-section="front">
    <header class="masthead">
      {% if demo_edition %}
      <div class="demo-notice">SAMPLE · SYNTHETIC FIXTURE CONTENT — NOT FOR PUBLICATION</div>
      {% endif %}
      <div class="masthead__rule"></div>
      <div class="masthead__top">
        <span>{{ edition_date }}</span>
        <span class="masthead__edition">{{ edition_name }} · Vol. {{ profile.issue_volume }} No. {{ edition.issue_number }}</span>
        <span>{{ profile.city }}</span>
      </div>
      <h1 class="masthead__name">{{ profile.name }}</h1>
      {% if profile.show_slogan and profile.slogan %}
      <div class="masthead__strap">
        <span>{{ profile.slogan }}</span>
      </div>
      {% endif %}
      <div class="masthead__rule masthead__rule--thick"></div>
    </header>

    <div class="front-grid">
      <article class="story story--front" data-story-id="{{ lead.story.id }}" data-article-id="{{ lead.article.id }}" data-chunk="1" data-chunk-count="{{ lead_chunks|length }}" data-template="{{ front_template }}">
        <div class="kicker">{{ section_label(lead.section) }}{% if lead.genre != 'news' %} · {{ genre_label(lead.genre) }}{% endif %}</div>
        <h2 class="story__headline story__headline--{{ lead.headline_size }}">{{ lead.headline }}</h2>
        {% if profile.byline %}<div class="story__byline">By {{ profile.byline }}</div>{% endif %}
        {{ story_qr(lead_chunks[0]) }}
        {% if lead.deck %}<p class="story__deck">{{ lead.deck }}</p>{% endif %}
        {% if lead.standfirst %}<p class="story__standfirst">{{ lead.standfirst }}</p>{% endif %}
        {% if media_html(lead) %}{{ media_html(lead) }}{% endif %}
        <div class="story__body">{{ paragraphs_html(lead_chunks[0].paragraphs) }}</div>
        {% if lead.chart_svg and not lead.media_path %}<figure class="story__graphic">{{ lead.chart_svg|safe }}</figure>{% endif %}
        {% if lead.timeline_html %}{{ lead.timeline_html|safe }}{% endif %}
        {% if lead.correction_note %}<p class="correction-note">{{ lead.correction_note }}</p>{% endif %}
        {% if lead_chunks|length > 1 %}<div class="continues" data-story-id="{{ lead.story.id }}" data-next-chunk="2">Continued on page <span class="page-ref">?</span></div>{% endif %}
      </article>

      <aside class="front-rail">
        <div class="rail-heading">Front briefs</div>
        {% for brief in front_briefs %}
        <div class="front-brief" data-story-id="{{ brief.story.id }}">
          <div class="front-brief__kicker">{{ section_label(brief.section) }}</div>
          <h3>{{ brief.headline }}</h3>
          <p>{{ brief.teaser }}</p>
          {% if brief.genre != 'news' %}<div class="front-brief__genre">{{ genre_label(brief.genre) }}</div>{% endif %}
        </div>
        {% endfor %}
        <div class="rail-heading rail-heading--inside">Inside</div>
        <ul class="inside-list">
          {% for section, items in sections %}
          <li><span>{{ section_label(section) }}</span><span class="inside-count">{{ items|length }}</span></li>
          {% endfor %}
        </ul>
      </aside>
    </div>

    {% if front_digest %}
    <section class="front-digest">
      <div class="front-digest__heading">More from this edition</div>
      <div class="front-digest__grid">
        {% for brief in front_digest %}
        <article class="front-brief front-digest__item" data-story-id="{{ brief.story.id }}">
          <div class="front-brief__kicker">{{ section_label(brief.section) }}</div>
          <h3>{{ brief.headline }}</h3>
          <p>{{ brief.teaser|truncate(105, end='…') }}</p>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <footer class="front-footer">
      <span>{{ edition_date }}</span>
      <span>{{ profile.name }}</span>
      <span class="page-number" data-page-number="1">1</span>
    </footer>
  </section>

  {% for section, items in sections %}
  <section class="page-section template-{{ templates[section] }}{% if not section_break[section] %} page-section--continue{% endif %}{% if section_chunks[section]|length > 1 %} section--multi{% endif %}{% if section_chunks[section]|length == 1 %} section--solo{% endif %}" data-template="{{ templates[section] }}" data-section="{{ section }}">
    <header class="section-head">
      <div class="section-head__label">{{ section_label(section) }}</div>
      <div class="section-head__rule"></div>
      <div class="section-head__meta">{{ edition_date }} · {{ profile.name }}</div>
    </header>
    {% if section == 'briefs' %}
    <div class="brief-grid">
      {% for chunk in section_chunks[section] %}
      <article class="story story--brief" data-story-id="{{ chunk.package.story.id }}" data-article-id="{{ chunk.package.article.id }}" data-chunk="{{ chunk.index }}" data-chunk-count="{{ chunk.count }}" data-template="briefs">
        <h2 class="story__headline story__headline--brief">{{ chunk.package.headline }}</h2>
        <div class="story__body">{{ paragraphs_html(chunk.paragraphs) }}</div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    {% if section_rows.get(section) %}
    <div class="story-flow story-flow--rows">
      {% for row in section_rows[section] %}
      <div class="story-row{% if row|length == 1 %} story-row--single{% endif %}">
        {% for chunk in row %}{{ story_article(chunk, section, templates[section]) }}{% endfor %}
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="story-flow{% if section in pair_sections %} story-flow--pair{% endif %}">
      {% for chunk in section_chunks[section] %}
      {{ story_article(chunk, section, templates[section]) }}
      {% endfor %}
    </div>
    {% endif %}
    {% endif %}
  </section>
  {% endfor %}
</main>
<script>
{{ paged_js|safe }}
</script>
<script>
{{ postprocess_js|safe }}
</script>
</body>
</html>
