{% extends "epaper_base.html.j2" %}
{% block title %}{{ profile.name }} — text edition{% endblock %}
{% block body %}
<header class="site-head site-head--text">
  <div class="site-head__top">
    <span>{{ edition_date }}</span>
    <span>{% if demo_edition %}Synthetic fixture edition — not for publication{% else %}Editorial roundup{% endif %}</span>
    <a href="index.html">Page viewer</a>
  </div>
  <h1>{{ profile.name }}</h1>
  <div class="site-head__strap"><span>{{ profile.slogan }}</span><span>{{ profile.channel_handle }}</span></div>
</header>

<main class="transcript">
  <p class="transcript__note">
    Text edition generated from the same edition data and quality-checked layout as the PDF. Source references
    point to the appendix below. This accessible transcript is not a substitute for the print proof when checking
    typography and page geometry.
    {% if profile.source_disclosure %}{{ profile.source_disclosure }}{% endif %}
  </p>
  {% for article in articles %}
  <article id="article-{{ loop.index }}" class="transcript__article">
    <div class="transcript__kicker">{{ article.section }} · {{ article.genre }}{% if article.pages %} · page {{ article.pages|join(', ') }}{% endif %}</div>
    <h2>{{ article.title }}</h2>
    {% if profile.byline %}<p class="transcript__byline">By {{ profile.byline }}</p>{% endif %}
    {% if article.deck %}<p class="transcript__deck">{{ article.deck }}</p>{% endif %}
    {% if article.standfirst %}<p class="transcript__standfirst">{{ article.standfirst }}</p>{% endif %}
    {% for paragraph in article.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
    {% if article.correction_note %}<p class="transcript__correction">{{ article.correction_note }}</p>{% endif %}
    <p class="transcript__sources">Sources: {{ article.source_refs|join(', ') if article.source_refs else 'see appendix' }}</p>
  </article>
  {% endfor %}
</main>

<section class="appendix">
  <h2>Sources &amp; provenance</h2>
  <table>
    <thead><tr><th>Ref</th><th>Published (UTC)</th><th>Message</th><th>Item</th><th>Link / status</th></tr></thead>
    <tbody>
      {% for entry in appendix_entries %}
      <tr>
        <td>{{ entry.ref }}</td>
        <td>{{ entry.date }}</td>
        <td>{{ entry.message_id if entry.message_id is not none else '—' }}</td>
        <td>{{ entry.article }}</td>
        <td>{% if entry.url %}<a href="{{ entry.url }}" rel="noopener noreferrer">{{ entry.url }}</a>{% else %}Fixture message — no public URL{% endif %}{% if entry.kind == 'external_link_unverified' %} <em>(external, not independently verified)</em>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="appendix__note">{{ profile.footer_text }}</p>
</section>
{% endblock %}
