{% extends "epaper_base.html.j2" %}
{% block title %}{{ profile.name }} — {{ edition_name }} — text edition{% endblock %}
{% block body %}
<header class="site-head site-head--text">
  <div class="site-head__top">
    <span>{{ edition_date }}</span>
    <span>{% if demo_edition %}SAMPLE · SYNTHETIC FIXTURE CONTENT{% else %}{{ edition_name }}{% endif %}</span>
    <a href="index.html">Page viewer</a>
  </div>
  <h1>{{ profile.name }}</h1>
  {% if profile.show_slogan and profile.slogan %}
  <div class="site-head__strap"><span>{{ profile.slogan }}</span></div>
  {% endif %}
</header>

<main class="transcript">
  <p class="transcript__note">
    Accessible text edition generated from the same edition data and quality-checked layout as the PDF.
    Source links appear beneath each report. This transcript is not a substitute for the print proof when
    checking typography and page geometry.
  </p>
  {% for article in articles %}
  <article id="article-{{ loop.index }}" class="transcript__article">
    <div class="transcript__kicker">{{ article.section }} · {{ article.genre }}{% if article.pages %} · page {{ article.pages|join(', ') }}{% endif %}</div>
    <h2>{{ article.title }}</h2>
    {% if profile.byline %}<p class="transcript__byline">By {{ profile.byline }}</p>{% endif %}
    {% if article.deck %}<p class="transcript__deck">{{ article.deck }}</p>{% endif %}
    {% if article.standfirst %}<p class="transcript__standfirst">{{ article.standfirst }}</p>{% endif %}
    {% for paragraph in article.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
    {% if article.correction_note %}<p class="transcript__correction">{{ article.correction_note }}</p>{% endif %}
    {% if article.sources %}
    <details class="transcript__sources">
      <summary>Sources</summary>
      <ul>
        {% for source in article.sources %}
        <li>
          {% if source.url and source.kind != 'fixture' %}
          <a href="{{ source.url }}" rel="noopener noreferrer">{{ source.title or source.channel or 'Original post' }}</a>
          {% else %}
          <span>{{ source.title or source.channel or 'Source report' }}</span>
          {% endif %}
          <span class="transcript__source-meta">{{ source.date }}{% if source.kind == 'external_link_unverified' %} · external, not independently verified{% endif %}</span>
        </li>
        {% endfor %}
      </ul>
      {% if article.public_id %}<p class="transcript__source-meta"><a href="sources/{{ article.public_id }}/index.html">Full source record</a></p>{% endif %}
    </details>
    {% endif %}
  </article>
  {% endfor %}
</main>
{% endblock %}
