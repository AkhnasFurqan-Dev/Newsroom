{% extends "epaper_base.html.j2" %}
{% block title %}{{ profile.name }} — {{ edition_date }}{% endblock %}
{% block body %}
<header class="site-head">
  <div class="site-head__top">
    <span>{{ edition_date }}</span>
    <span>{% if demo_edition %}SAMPLE · SYNTHETIC FIXTURE CONTENT{% else %}{{ edition_name }}{% endif %}</span>
    <a href="text.html">Text edition</a>
    <a href="sources/index.html">Sources</a>
  </div>
  <h1>{{ profile.name }}</h1>
  {% if profile.show_slogan and profile.slogan %}
  <div class="site-head__strap">
    <span>{{ profile.slogan }}</span>
  </div>
  {% endif %}
</header>

<div class="viewer" id="viewer">
  <div class="viewer__bar">
    <button type="button" id="prev" aria-label="Previous page">← Previous</button>
    <label class="viewer__select">Page
      <select id="page-select">
        {% for page in pages %}
        <option value="{{ page.number }}">{{ page.number }} — {{ page.section|default('front', true) }}</option>
        {% endfor %}
      </select>
      of {{ pages|length }}
    </label>
    <button type="button" id="next" aria-label="Next page">Next →</button>
    <button type="button" id="zoom">Actual size</button>
    <a class="viewer__download" href="../sample_issue.pdf">Print PDF</a>
  </div>
  <div class="viewer__stage" id="stage">
    {% for page in pages %}
    <figure class="viewer__page{% if loop.first %} is-active{% endif %}" data-page="{{ page.number }}"{% if not loop.first %} hidden{% endif %}>
      <img src="{{ page.image }}" alt="Page {{ page.number }} of {{ profile.name }}, {{ edition_date }}" loading="{{ 'eager' if loop.first else 'lazy' }}">
      <figcaption>Page {{ page.number }} of {{ pages|length }} · {{ page.template }}</figcaption>
    </figure>
    {% endfor %}
  </div>
</div>

<section class="article-index">
  <h2>Reports in this edition</h2>
  <ul>
    {% for article in articles %}
    <li>
      <span class="article-index__section">{{ article.section }}</span>
      <a href="text.html#article-{{ loop.index }}">{{ article.title }}</a>
      <span class="article-index__page">{% if article.pages %}p. {{ article.pages|join(', ') }}{% endif %}</span>
      {% if article.sources %}
      <details class="article-index__sources">
        <summary>Sources</summary>
        <ul>
          {% for source in article.sources %}
          <li>
            {% if source.url and source.kind != 'fixture' %}
            <a href="{{ source.url }}" rel="noopener noreferrer">{{ source.title or source.channel or 'Original post' }}</a>
            {% else %}
            <span>{{ source.title or source.channel or 'Source report' }}</span>
            {% endif %}
            <span class="article-index__meta">{{ source.date }}{% if source.kind == 'external_link_unverified' %} · external, not independently verified{% endif %}</span>
          </li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endblock %}
