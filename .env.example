# Copy to .env only if you need to override defaults. Never commit .env.
# All values below are non-secret defaults.

CHANNEL_PRESS_HOST=127.0.0.1
CHANNEL_PRESS_PORT=8765
CHANNEL_PRESS_DATA_DIR=./data
CHANNEL_PRESS_DATABASE_URL=sqlite:///./data/channel_press.db
CHANNEL_PRESS_TIMEZONE=Asia/Karachi
CHANNEL_PRESS_SESSION_HOURS=12
CHANNEL_PRESS_COOKIE_SECURE=false
CHANNEL_PRESS_DEMO_MODE=true

# Optional public publication origin used for QR links. The app verifies a URL
# before printing a QR code; leave blank for the honest offline appendix mode.
CHANNEL_PRESS_PUBLIC_BASE_URL=

# Optional local model endpoint (Ollama-compatible). The deterministic fixture
# provider is always available and needs no model.
CHANNEL_PRESS_OLLAMA_BASE_URL=http://127.0.0.1:11434
CHANNEL_PRESS_OLLAMA_MODEL=qwen2.5:3b-instruct
CHANNEL_PRESS_OLLAMA_KEEP_ALIVE=60s

# Optional Telegram MTProto configuration. Leave blank until authorization and
# content rights are recorded in the application. The app never reads these
# directly outside the isolated adapter.
CHANNEL_PRESS_TELEGRAM_API_ID=
CHANNEL_PRESS_TELEGRAM_API_HASH=
CHANNEL_PRESS_TELEGRAM_SESSION_PATH=./data/telegram.session
