# Copy to .env only if you need to override defaults. Never commit .env.
# All values below are non-secret defaults.

CHANNEL_PRESS_HOST=127.0.0.1
CHANNEL_PRESS_PORT=8765
CHANNEL_PRESS_DATA_DIR=./data
CHANNEL_PRESS_DATABASE_URL=sqlite:///./data/channel_press.db
CHANNEL_PRESS_TIMEZONE=Asia/Karachi
CHANNEL_PRESS_SESSION_HOURS=12
CHANNEL_PRESS_COOKIE_SECURE=false
CHANNEL_PRESS_DEMO_MODE=true

# Optional public evidence-page origin used for printed story codes. A QR is
# only printed when the owner has verified this origin. Leave blank to print no
# code rather than a broken target.
CHANNEL_PRESS_PUBLIC_BASE_URL=

# Automatic story discovery. No provider is required for the offline features.
# Google and Brave are documented APIs; the publisher-RSS fallback is keyless.
# GDELT DOC 2.0 is available as a public API but asks for one request every
# five seconds, so it is a deliberate choice rather than the default.
CHANNEL_PRESS_GOOGLE_CSE_API_KEY=
CHANNEL_PRESS_GOOGLE_CSE_CX=
CHANNEL_PRESS_BRAVE_SEARCH_API_KEY=
CHANNEL_PRESS_SEARCH_TIMEOUT_SECONDS=10
CHANNEL_PRESS_SEARCH_TIMESPAN_DAYS=7
# Comma-separated publisher feeds used by the keyless fallback.
CHANNEL_PRESS_SEARCH_RSS_FEEDS=https://www.dawn.com/feeds/home,https://feeds.bbci.co.uk/news/world/rss.xml

# Optional local model endpoint (Ollama-compatible). The deterministic fixture
# provider is always available and needs no model.
CHANNEL_PRESS_OLLAMA_BASE_URL=http://127.0.0.1:11434
CHANNEL_PRESS_OLLAMA_MODEL=qwen3.5:4b-q4_K_M
CHANNEL_PRESS_OLLAMA_MODEL_PROFILE=standard
CHANNEL_PRESS_OLLAMA_KEEP_ALIVE=60s

# Optional Telegram MTProto configuration. Leave blank until authorization and
# content rights are recorded in the application. The app never reads these
# directly outside the isolated adapter.
CHANNEL_PRESS_TELEGRAM_API_ID=
CHANNEL_PRESS_TELEGRAM_API_HASH=
CHANNEL_PRESS_TELEGRAM_SESSION_PATH=./data/telegram.session

# Bounded source-media downloads. Rendering always uses local files only.
CHANNEL_PRESS_TELEGRAM_DOWNLOAD_MEDIA=true
CHANNEL_PRESS_TELEGRAM_MAX_MEDIA_MB=25
CHANNEL_PRESS_TELEGRAM_MAX_VIDEO_MB=120
CHANNEL_PRESS_MEDIA_MAX_ASSETS_PER_STORY=3
CHANNEL_PRESS_MEDIA_DOWNLOAD_ATTEMPTS=2
# Newly downloaded media younger than this is protected from cache clearing.
CHANNEL_PRESS_MEDIA_RETENTION_HOURS=72
