# Channel Press — post-M14 live configuration EXAMPLE ONLY.
# Coding agent: reconcile each name with channel_press Settings and existing .env.example.
# Create E:\newsroom\.env only if absent. NEVER overwrite existing .env values.
# Owner fills private values manually. Do not commit .env or any *.session file.

# Telegram MTProto app credentials from my.telegram.org
CHANNEL_PRESS_TELEGRAM_API_ID=
CHANNEL_PRESS_TELEGRAM_API_HASH=

# Session location: private, non-public, excluded from Git.
CHANNEL_PRESS_TELEGRAM_SESSION_PATH=./data/telegram.session

# Source handle, e.g. @my_channel. Supported only after agent wires Settings/UI.
# CHANNEL_PRESS_TELEGRAM_SOURCE_USERNAME=

# The following are OPERATIONAL PREFERENCES, not guaranteed existing Settings keys.
# Agent MUST implement and document the actual matching config/UI fields
# before enabling any of them. Keep schedule defaults editable in UI.
# CHANNEL_PRESS_TIMEZONE=Asia/Karachi
# CHANNEL_PRESS_CUTOFF_LOCAL_TIME=08:00
# CHANNEL_PRESS_INITIAL_CONTEXT_LOOKBACK_DAYS=30
# CHANNEL_PRESS_AUTO_RELEASE=false

# Phone verification code and 2FA password are NOT .env variables.
# Collect interactively in a secured local login flow; do not persist them.
# Publication/source authorization is separate from API credentials.
